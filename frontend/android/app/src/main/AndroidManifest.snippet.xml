<!-- Add inside the <manifest> tag of android/app/src/main/AndroidManifest.xml -->
<uses-permission android:name="android.permission.CAMERA" />
<uses-feature android:name="android.hardware.camera" android:required="true" />
<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

<!-- Inside <application>, if targeting Android 12+/API 31+, camera plugin needs no extra config,
     but make sure minSdkVersion in android/app/build.gradle is >= 21. -->
